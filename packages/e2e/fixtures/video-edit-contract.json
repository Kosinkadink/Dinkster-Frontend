            ]
          },
          "required": true,
          "tooltip": "The video to save."
        },
        {
          "kind": "row",
          "rows": [
            {
              "kind": "input",
              "id": "filename_prefix",
              "type": {
                "kind": "concrete",
                "types": [
                  "STRING"
                ]
              },
              "required": true,
              "default": "video/ComfyUI",
              "widget": {
                "type": "STRING",
                "multiline": false
              },
              "tooltip": "The prefix for the file to save. This may include formatting information such as %date:yyyy-MM-dd% or %Empty Latent Image.width% to include values from nodes."
            },
            {
              "kind": "input",
              "id": "mount",
              "type": {
                "kind": "concrete",
                "types": [
                  "STRING"
                ]
              },
              "required": false,
              "widget": {
                "type": "MOUNT"
              }
            }
          ]
        },
        {
          "kind": "choice",
          "id": "format",
          "tooltip": "The output container. Auto uses MP4 for Auto/H.264 and WebM for AV1. MP4, MKV, and WebM select a specific container.",
          "options": [
            {
              "key": "auto",
              "rows": [
                {
                  "kind": "use",
                  "id": "codec"
                }
              ]
            },
            {
              "key": "mp4",
              "rows": [
                {
                  "kind": "use",
                  "id": "codec"
                }
              ]
            },
            {
              "key": "mkv",
              "rows": [
                {
                  "kind": "use",
                  "id": "codec"
                }
              ]
            },
            {
              "key": "webm",
              "rows": [
                {
                  "kind": "use",
                  "id": "codec",
                  "only": [
                    "auto",
                    "av1"
                  ]
                }
              ]
            }
          ],
          "shared": [
            {
              "kind": "choice",
              "id": "codec",
              "tooltip": "The output video codec. Auto preserves a compatible source stream. H.264 and AV1 re-encoding support SDR, HDR (HLG), and HDR PQ.",
              "options": [
                {
                  "key": "auto",
                  "rows": []
                },
                {
                  "key": "h264",
                  "rows": [
                    {
                      "kind": "use",
                      "id": "encoding"
                    }
                  ]
                },
                {
                  "key": "av1",
                  "rows": [
                    {
                      "kind": "use",
                      "id": "encoding",
                      "tooltip": "Automatic preserves compatible AV1 streams. Re-encode applies custom encoding options.",
                      "inside": [
                        {
                          "kind": "use",
                          "id": "crf",
                          "widget": {
                            "type": "NUMBER",
                            "min": 0.0,
                            "max": 63.0,
                            "step": 1.0
                          },
                          "default": 24.0
                        }
                      ]
                    }
                  ]
                }
              ],
              "shared": [
                {
                  "kind": "choice",
                  "id": "encoding",
                  "label": "encoding mode",
                  "tooltip": "Automatic preserves compatible H264 streams. Re-encode applies custom encoding options.",
                  "options": [
                    {
                      "key": "auto",
                      "rows": []
                    },
                    {
                      "key": "re-encode",
                      "rows": [
                        {
                          "kind": "input",
                          "id": "crf",
                          "type": {
                            "kind": "concrete",
                            "types": [
                              "FLOAT"
                            ]
                          },
                          "required": true,
                          "default": 18.0,
                          "widget": {
                            "type": "NUMBER",
                            "min": 0.0,
                            "max": 51.0,
                            "step": 1.0
                          },
                          "tooltip": "Lower values produce higher quality and larger files."
                        }
                      ]
                    }
                  ],
                  "required": false
                }
              ]
            }
          ]
        },
