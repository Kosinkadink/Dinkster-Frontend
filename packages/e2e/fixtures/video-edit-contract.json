      "schemaVersion": 2,
      "nodeType": "dinkster.video.save_video",
      "version": 1,
      "displayName": "Save Video",
      "category": "video",
      "description": "Saves the input videos to your ComfyUI output directory.",
      "idempotent": false,
      "interface": [],
      "body": [
        {
          "kind": "input",
          "id": "video",
          "type": {
            "kind": "concrete",
            "types": [
