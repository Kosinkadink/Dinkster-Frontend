{
  "schemaVersion": 2,
  "nodeType": "comfy.ResizeImageMaskNode",
  "version": 1,
  "displayName": "Resize Image/Mask",
  "category": "comfy/image/transform",
  "description": "Resize an image or mask using various scaling methods.",
  "idempotent": true,
  "aliases": [
    "ResizeImageMaskNode"
  ],
  "pack": "comfy",
  "signature": "321bd539299a33d45000d3991dcb21aadcebfdbe",
  "body": [
    {
      "kind": "input",
      "id": "input",
      "type": {
        "kind": "variable",
        "templateId": "input_type",
        "allowed": [
          "comfy.IMAGE",
          "comfy.MASK"
        ]
      },
      "required": true
    },
    {
      "kind": "input",
      "id": "scale_method",
      "type": {
        "kind": "concrete",
        "types": [
          "COMBO"
        ]
      },
      "required": false,
      "default": "area",
      "widget": {
        "type": "COMBO",
        "options": [
          "nearest-exact",
          "bilinear",
          "area",
          "bicubic",
          "lanczos"
        ]
      }
    },
    {
      "kind": "choice",
      "id": "resize_type",
      "options": [
        {
          "key": "scale dimensions",
          "rows": [
            {
              "kind": "use",
              "id": "width"
            },
            {
              "kind": "use",
              "id": "height"
            },
            {
              "kind": "use",
              "id": "crop"
            }
          ]
        },
        {
          "key": "scale by multiplier",
          "rows": [
            {
              "kind": "input",
              "id": "multiplier",
              "type": {
                "kind": "concrete",
                "types": [
                  "FLOAT"
                ]
              },
              "required": false,
              "default": 1.0,
              "tooltip": "Scale factor (e.g., 2.0 doubles size, 0.5 halves size)."
            }
          ]
        },
        {
          "key": "scale longer dimension",
          "rows": [
            {
              "kind": "input",
              "id": "longer_size",
              "type": {
                "kind": "concrete",
                "types": [
                  "INT"
                ]
              },
              "required": false,
              "default": 512,
              "tooltip": "The longer edge will be resized to this value. Aspect ratio is preserved."
            }
          ]
        },
        {
          "key": "scale shorter dimension",
          "rows": [
            {
              "kind": "input",
              "id": "shorter_size",
              "type": {
                "kind": "concrete",
                "types": [
                  "INT"
                ]
              },
              "required": false,
              "default": 512,
              "tooltip": "The shorter edge will be resized to this value. Aspect ratio is preserved."
            }
          ]
        },
        {
          "key": "scale width",
          "rows": [
            {
              "kind": "use",
              "id": "width"
            }
          ]
        },
        {
          "key": "scale height",
          "rows": [
            {
              "kind": "use",
              "id": "height"
            }
          ]
        },
        {
          "key": "scale total pixels",
          "rows": [
            {
              "kind": "input",
              "id": "megapixels",
              "type": {
                "kind": "concrete",
                "types": [
                  "FLOAT"
                ]
              },
              "required": false,
              "default": 1.0,
              "tooltip": "Target total megapixels (e.g., 1.0 ~ 1024x1024). Aspect ratio is preserved."
            }
          ]
        },
        {
          "key": "match size",
          "rows": [
            {
              "kind": "input",
              "id": "match",
              "type": {
                "kind": "union",
                "types": [
                  "comfy.IMAGE",
                  "comfy.MASK"
                ]
              },
              "required": true,
              "tooltip": "Resize input to match the dimensions of this reference image or mask."
            },
            {
              "kind": "use",
              "id": "crop"
            }
          ]
        },
        {
          "key": "scale to multiple",
          "rows": [
            {
              "kind": "input",
              "id": "multiple",
              "type": {
                "kind": "concrete",
                "types": [
                  "INT"
                ]
              },
              "required": false,
              "default": 8,
              "tooltip": "Resize so width and height are divisible by this number. Useful for latent alignment (e.g., 8 or 64)."
            }
          ]
        }
      ],
      "shared": [
        {
          "kind": "input",
          "id": "width",
          "type": {
            "kind": "concrete",
            "types": [
              "INT"
            ]
          },
          "required": false,
          "default": 512,
          "tooltip": "Target width in pixels. Set to 0 to auto-calculate from height while preserving aspect ratio."
        },
        {
          "kind": "input",
          "id": "height",
          "type": {
            "kind": "concrete",
            "types": [
              "INT"
            ]
          },
          "required": false,
          "default": 512,
          "tooltip": "Target height in pixels. Set to 0 to auto-calculate from width while preserving aspect ratio."
        },
        {
          "kind": "input",
          "id": "crop",
          "type": {
            "kind": "concrete",
            "types": [
              "COMBO"
            ]
          },
          "required": false,
          "default": "center",
          "widget": {
            "type": "COMBO",
            "options": [
              "disabled",
              "center"
            ]
          },
          "tooltip": "How to handle aspect ratio mismatch: 'disabled' stretches to fit, 'center' crops to maintain aspect ratio."
        }
      ],
      "tooltip": "Select how to resize: by exact dimensions, scale factor, matching another image, etc."
    },
    {
      "kind": "output",
      "id": "resized",
      "type": {
        "kind": "variable",
        "templateId": "input_type",
        "allowed": [
          "comfy.IMAGE",
          "comfy.MASK"
        ]
      }
    }
  ]
}
