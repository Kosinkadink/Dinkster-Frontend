 "dev.buttons.member_steps": {
  "body": [
   {
    "grows": "button",
    "id": "loras",
    "keys": {
     "numbered": {
      "pad": 0,
      "prefix": "lora_",
      "start": 1
     }
    },
    "kind": "group",
    "maxMembers": 4,
    "member": [
     {
      "default": "none",
      "id": "name",
      "kind": "input",
      "required": true,
      "type": {
       "kind": "concrete",
       "types": [
        "STRING"
       ]
      }
     },
     {
      "default": 1.0,
      "id": "strength",
      "kind": "input",
      "required": true,
      "type": {
       "kind": "concrete",
       "types": [
        "FLOAT"
       ]
      },
      "widget": {
       "max": 2.0,
       "min": -2.0,
       "type": "NUMBER"
      }
     },
     {
      "id": "clip",
      "kind": "input",
      "required": false,
      "type": {
       "kind": "concrete",
       "types": [
        "dev.image"
       ]
      }
     }
    ],
    "minMembers": 1
   },
   {
    "kind": "row",
    "rows": [
     {
      "icon": "plus",
      "id": "add",
      "kind": "button",
      "label": "Add",
      "steps": [
       {
        "group": "loras",
        "step": "addMember",
        "values": {
         "name": {
          "value": "added"
         },
         "strength": {
          "formula": "len(loras) * 0.5"
         }
        }
       }
      ]
     },
     {
      "id": "remove_first",
      "kind": "button",
      "label": "Remove first",
      "steps": [
       {
        "group": "loras",
        "step": "removeMember",
        "which": "first"
       }
      ]
     },
     {
      "id": "remove_last",
      "kind": "button",
      "label": "Remove last",
      "steps": [
       {
        "group": "loras",
        "step": "removeMember",
        "which": "last"
       }
      ]
     },
     {
      "id": "remove_second",
      "kind": "button",
      "label": "Remove 2nd",
      "steps": [
       {
        "group": "loras",
        "step": "removeMember",
        "which": {
         "formula": "1"
        }
       }
      ]
     }
    ]
   },
   {
    "kind": "row",
    "rows": [
     {
      "icon": "trash-2",
      "id": "clear",
      "kind": "button",
      "label": "Clear",
      "steps": [
       {
        "group": "loras",
        "step": "clearMembers"
       }
      ]
     },
     {
      "id": "copy_first",
      "kind": "button",
      "label": "Copy first",
      "steps": [
       {
        "field": "strength",
        "group": "loras",
        "step": "setEach",
        "value": {
         "formula": "loras.strength[0]"
        }
       }
      ]
     },
     {
      "id": "halve_each",
      "kind": "button",
      "label": "Halve each",
      "steps": [
       {
        "field": "strength",
        "group": "loras",
        "step": "setEach",
        "value": {
         "formula": "strength / 2"
        }
       }
      ]
     }
    ]
   }
  ],
  "category": "dev/buttons",
  "description": "Buttons that add, remove and fill the members of a group.",
  "displayName": "Buttons: member steps",
  "idempotent": true,
  "interface": [],
  "nodeType": "dev.buttons.member_steps",
  "schemaVersion": 2,
  "version": 1
 },
 "dev.buttons.seed": {
  "body": [
   {
    "afterRun": "randomize",
    "default": 0,
    "id": "seed",
    "kind": "input",
    "required": true,
    "type": {
     "kind": "concrete",
     "types": [
      "INT"
     ]
    },
    "widget": {
     "max": 1125899906842624,
     "min": -1125899906842624,
     "type": "NUMBER"
    }
   },
   {
    "kind": "row",
    "rows": [
     {
      "id": "each_time",
      "kind": "button",
      "label": "Each time",
      "steps": [
       {
        "field": "seed",
        "mode": "randomize",
        "step": "setMode"
       }
      ]
     },
     {
      "id": "new_fixed_random",
      "kind": "button",
      "label": "New",
      "steps": [
       {
        "field": "seed",
        "step": "randomize"
       },
       {
        "field": "seed",
        "mode": "fixed",
        "step": "setMode"
       }
      ]
     }
    ]
   },
   {
    "id": "SEED",
    "kind": "output",
    "type": {
     "kind": "concrete",
     "types": [
      "INT"
     ]
    }
   }
  ],
  "category": "dev/buttons",
  "description": "A seed with its after-run controller and a button that picks a new fixed random seed.",
  "displayName": "Seed",
  "idempotent": true,
  "interface": [],
  "nodeType": "dev.buttons.seed",
  "schemaVersion": 2,
  "version": 1
 },
 "dev.buttons.translate": {
  "body": [
   {
    "default": "auto",
    "id": "from_translate",
    "kind": "input",
    "required": true,
    "type": {
     "kind": "concrete",
     "types": [
      "COMBO"
     ]
    },
    "widget": {
     "options": [
      "auto",
      "en",
      "es",
      "fr"
     ],
     "type": "COMBO"
    }
   },
   {
    "default": "en",
    "id": "to_translate",
    "kind": "input",
    "required": true,
    "type": {
     "kind": "concrete",
     "types": [
      "COMBO"
     ]
    },
    "widget": {
     "options": [
      "en",
      "es",
      "fr"
     ],
     "type": "COMBO"
    }
   },
   {
    "default": true,
    "id": "manual_translate",
    "kind": "input",
    "required": true,
    "type": {
     "kind": "concrete",
     "types": [
      "BOOLEAN"
     ]
    }
   },
   {
    "disabledReason": "Manual translate is off. The translation happens when you press Run.",
    "enabled": {
     "formula": "manual_translate"
    },
    "icon": "languages",
    "id": "translate",
    "kind": "button",
    "label": "Translate",
    "steps": [
     {
      "args": [
       "text",
       "from_translate",
       "to_translate",
       "service_delay"
      ],
      "function": "dinkster_nodes_dev.buttons.translate_now",
      "step": "call",
      "writes": [
       "text"
      ]
     }
    ]
   },
   {
    "default": "hola, un gato en la playa",
    "id": "text",
    "kind": "input",
    "required": true,
    "type": {
     "kind": "concrete",
     "types": [
      "STRING"
     ]
    },
    "widget": {
     "multiline": true,
     "placeholder": "Input prompt",
     "type": "STRING"
    }
   },
   {
    "default": 0.0,
    "id": "service_delay",
    "kind": "state",
    "partOfRun": false,
    "type": {
     "kind": "concrete",
     "types": [
      "FLOAT"
     ]
    }
   },
   {
    "id": "text",
    "kind": "output",
    "type": {
     "kind": "concrete",
     "types": [
      "STRING"
     ]
    }
   }
  ],
  "category": "dev/buttons",
  "description": "Press Translate to translate the text in place with a local test service.",
  "displayName": "Translate text",
  "idempotent": true,
  "interface": [],
  "menu": [
   {
    "id": "menu_translate",
    "kind": "button",
    "label": "Translate to English",
    "steps": [
     {
      "args": [
       "text",
       "from_translate",
       {
        "formula": "\"en\""
       },
       "service_delay"
      ],
      "function": "dinkster_nodes_dev.buttons.translate_now",
      "step": "call",
      "writes": [
       "text"
      ]
     }
    ]
   }
  ],
  "nodeType": "dev.buttons.translate",
  "schemaVersion": 2,
  "version": 1
 },
